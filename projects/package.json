{
    "private": true,
    "scripts": {
        "build": "pnpm --filter @neontechspace/fluxerly build && pnpm --filter fluxerly-docs build",
        "lint": "node scripts/lint.mjs",
        "check": "node scripts/check.mjs",
        "verify:changed": "node scripts/check.mjs --changed",
        "verify:deep": "FLUXERLY_FUZZ_ITERATIONS=500 pnpm --filter @neontechspace/fluxerly exec vitest run tests/client/wire-fuzz.test.ts tests/client/rate-limits-model.test.ts tests/resources/cache/cache-linearizability.test.ts tests/events/event-source-property.test.ts tests/client/gateway-pacer-property.test.ts tests/client/chaos-simulation.test.ts",
        "lint:scripts": "oxlint -c .oxlintrc.json scripts",
        "lint:docs-links": "node scripts/docs-links.mjs",
        "check:contributions": "node --import ./scripts/no-fluxer-network.mjs --test ../.github/tests/*.test.mjs",
        "changeset": "node release/cli.js changeset",
        "release:plan": "node release/cli.js plan",
        "release:check": "node release/cli.js check-support",
        "release:inspect": "node release/cli.js inspect",
        "release:status": "node release/cli.js status",
        "release:version": "node release/cli.js version",
        "release:prepare": "node release/cli.js prepare",
        "release:verify": "node release/cli.js verify",
        "release:publish": "node release/cli.js publish",
        "docs:dev": "pnpm --filter @neontechspace/fluxerly build && pnpm run docs:dev:skip-build",
        "docs:dev:skip-build": "pnpm --filter fluxerly-docs generate && pnpm --filter fluxerly-docs dev"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": ">=12 <13",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "cspell": "10.5.2",
        "knip": "6.48.0",
        "oxlint": "1.95.0",
        "oxlint-tsgolint": "7.0.2008"
    }
}
