{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": ["node"],
        "paths": { "@content/*": ["./content/*"] }
    },
    "include": [".astro/types.d.ts", "src/**/*", "tests/**/*"],
    "exclude": ["dist"]
