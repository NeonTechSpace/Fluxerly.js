{
    "name": "fluxerly-docs",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "dev": "astro dev",
        "generate": "node scripts/docs/generate.mjs",
        "build": "pnpm run generate && astro build && pagefind --site dist",
        "build:public": "node scripts/docs/build-public.mjs",
        "preview": "astro preview",
        "lint": "oxlint -c .oxlintrc.json scripts src tests functions && node ../scripts/em-dashes.mjs .",
        "check": "pnpm run lint && pnpm run build && astro check && pnpm run test",
        "check:public": "pnpm run lint && pnpm run generate && pnpm run build:public && astro check && pnpm run test",
        "check:ui": "node scripts/checks/ui.mjs",
        "test": "node --test \"tests/*.test.ts\" \"tests/*.test.js\"",
        "test:browser": "node scripts/checks/sweep.mjs",
        "test:versions": "node scripts/checks/versions.mjs",
        "prepare:art": "node scripts/prepare-art.mjs",
        "downloads:fetch": "node scripts/fetch-downloads.mjs"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.3.4",
        "@astrojs/react": "7.1.1",
        "@fontsource-variable/outfit": "5.3.0",
        "@phosphor-icons/react": "2.1.10",
        "@tailwindcss/vite": "4.3.3",
        "astro": "7.4.2",
        "gsap": "3.15.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwindcss": "4.3.3",
        "three": "0.186.1"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.186.0",
        "pagefind": "1.5.2",
        "playwright": "1.64.1",
        "sharp": "0.35.5",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "wrangler": "4.152.0"
    }
}
