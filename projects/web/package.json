{
    "name": "fluxerly-docs",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "dev": "astro dev",
        "generate": "node scripts/docs/generate.mjs",
        "build": "pnpm run generate && astro build && pagefind --site dist && node scripts/docs/search-words.mjs dist",
        "build:public": "node scripts/docs/build-public.mjs",
        "preview": "astro preview",
        "lint": "oxlint -c .oxlintrc.json scripts src tests && node ../scripts/em-dashes.mjs .",
        "check": "node ../scripts/check.mjs web",
        "check:types": "astro check",
        "check:public": "node ../scripts/check.mjs public",
        "check:ui": "node scripts/checks/ui.mjs",
        "test": "node --import ../scripts/no-fluxer-network.mjs --test \"tests/*.test.ts\" \"tests/*.test.js\"",
        "test:search": "node --import ../scripts/no-fluxer-network.mjs scripts/checks/search.mjs",
        "test:browser": "node scripts/checks/sweep.mjs",
        "test:versions": "node scripts/checks/versions.mjs",
        "prepare:art": "node scripts/prepare-art.mjs",
        "downloads:fetch": "node scripts/fetch-downloads.mjs"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.3.5",
        "@astrojs/react": "7.1.2",
        "@fontsource-variable/outfit": "5.3.0",
        "@phosphor-icons/react": "2.1.10",
        "@tailwindcss/vite": "4.3.3",
        "astro": "7.4.4",
        "gsap": "3.15.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.3",
        "three": "0.187.0"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.187.0",
        "pagefind": "1.6.0",
        "playwright": "1.64.1",
        "sharp": "0.35.5",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "wrangler": "4.156.0"
    }
}
