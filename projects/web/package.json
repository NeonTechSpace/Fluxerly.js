{
    "name": "fluxerly-docs",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "dev": "astro dev",
        "generate": "node scripts/generate.js",
        "build": "pnpm run generate && astro build",
        "build:public": "node scripts/generate.js --public && astro build",
        "preview": "astro preview",
        "lint": "astro sync && oxlint -c ../.oxlintrc.json scripts src tests",
        "check": "pnpm run lint && pnpm run build && astro check && node --test tests/*.test.js",
        "check:public": "pnpm run lint && pnpm run build:public && astro check && node --test tests/*.test.js",
        "test:browser": "playwright test",
        "test:versions": "node tests/version-fixtures.js",
        "test:snapshots": "node tests/snapshot-builds.js"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "7.3.3",
        "@astrojs/mdx": "8.1.0",
        "@astrojs/react": "7.1.0",
        "@fontsource-variable/outfit": "5.3.0",
        "@phosphor-icons/react": "2.1.10",
        "@tailwindcss/vite": "4.3.3",
        "astro": "7.4.0",
        "fumadocs-core": "16.17.5",
        "fumadocs-ui": "16.17.5",
        "github-slugger": "2.0.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwindcss": "4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.64.1",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "typedoc": "0.28.20",
        "typedoc-plugin-frontmatter": "1.3.3",
        "typedoc-plugin-markdown": "4.14.0",
        "typescript": "6.0.3",
        "wrangler": "4.151.1"
    }
}
