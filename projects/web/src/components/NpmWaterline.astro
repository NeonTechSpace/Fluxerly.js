---
import { CaretRightIcon, CheckIcon, CopyIcon } from "@phosphor-icons/react/ssr"
import { links, packageManagers } from "../lib/links"

// The first package manager is the server-rendered default. The script restores the saved choice
const first = packageManagers[0]
const [tool, pkg, ...tail] = splitCommand(first.install)

function splitCommand(command: string) {
    const words = command.split(" ")
    const at = words.findIndex((word) => word.startsWith("@"))
    return [words.slice(0, at).join(" "), words[at], ...words.slice(at + 1)] as const
}

const npmMark =
    "M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"
---

<div class="row" data-waterline>
    <a class="coin" href={links.npm} target="_blank" rel="noopener" aria-label="Fluxerly.js on npm">
        <svg class="npm-mark" viewBox="0 0 24 24" fill-rule="evenodd" aria-hidden="true" focusable="false"><path d={npmMark}></path></svg>
    </a>

    <div class="chip-wrap">
        <div class="chip">
            <code data-command><span class="muted" data-tool>{tool}</span> <span data-pkg set:html={pkg.replace("/", "<wbr>/")}></span> <span class="muted" data-tail>{tail.join(" ")}</span></code>
            <button class="tool-button pick" type="button" aria-expanded="false" aria-controls="waterline-menu" aria-label="Choose package manager and command" data-pick>
                <CaretRightIcon size={15} weight="bold" aria-hidden="true" />
            </button>
            <button class="tool-button copy" type="button" aria-label="Copy command" data-copy={first.install}>
                <CopyIcon className="icon-copy" size={17} aria-hidden="true" />
                <CheckIcon className="icon-done" size={17} weight="bold" aria-hidden="true" />
            </button>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
        </div>


    <!-- How you work: package manager, and whether to add the SDK or start a project. Opens from the caret, along the water, over the scene, never in the flow -->
    <div class="menu" id="waterline-menu" hidden data-menu>
        <fieldset class="menu-row" data-group="pm"><legend class="sr-only">Package manager</legend>
            {packageManagers.map((item) => <label class="option" data-value={item.id}><input type="radio" name="waterline-pm" value={item.id} checked={item.id === first.id} />{item.label}</label>)}
        </fieldset>
        <span class="menu-divider" aria-hidden="true"></span>
        <fieldset class="menu-row" data-group="mode"><legend class="sr-only">Command</legend>
            <label class="option" data-value="install"><input type="radio" name="waterline-mode" value="install" checked />install</label>
            <label class="option" data-value="init"><input type="radio" name="waterline-mode" value="init" />init</label>
        </fieldset>
    </div>
    </div>

    <!-- Reflections on the water. Decoration only -->
    <div class="reflection" aria-hidden="true" inert>
        <span class="coin"><svg class="npm-mark" viewBox="0 0 24 24" fill-rule="evenodd"><path d={npmMark}></path></svg></span>
        <span class="chip"><code data-command><span class="muted" data-tool>{tool}</span> <span data-pkg set:html={pkg.replace("/", "<wbr>/")}></span> <span class="muted" data-tail>{tail.join(" ")}</span></code><span class="tool-button"><CaretRightIcon size={15} weight="bold" /></span><span class="tool-button"><CopyIcon size={17} /></span></span>
    </div>
</div>

<script>
    import { reportCopyFailed } from "../lib/copy-failed"
    import { getExperience, subscribeExperience } from "../lib/experience"
    import { packageManagers, type PackageManager } from "../lib/links"

    const pmKey = "fluxerly.pm.v1"
    const modeKey = "fluxerly.cmd.v1"
    type Mode = "install" | "init"

    const root = document.querySelector<HTMLElement>("[data-waterline]")
    if (root) {
        // The hero sits outside the night, so the row carries Still itself for its icon swaps
        const markStill = (mode: string) => root.toggleAttribute("data-still", mode === "still")
        markStill(getExperience())
        subscribeExperience(markStill)

        const read = (key: string) => {
            try {
                return window.localStorage.getItem(key)
            } catch {
                return null
            }
        }
        const write = (key: string, value: string) => {
            try {
                window.localStorage.setItem(key, value)
            } catch {
                // Storage is blocked, the choice lasts for this page
            }
        }
        const isManager = (value: unknown): value is PackageManager => packageManagers.some((item) => item.id === value)

        let pm: PackageManager = isManager(read(pmKey)) ? (read(pmKey) as PackageManager) : "npm"
        let mode: Mode = read(modeKey) === "init" ? "init" : "install"

        const split = (command: string) => {
            const words = command.split(" ")
            const at = words.findIndex((word) => word.startsWith("@"))
            return { tool: words.slice(0, at).join(" "), pkg: words[at], tail: words.slice(at + 1).join(" ") }
        }

        // The menu leaves the hero, which clips what overflows it, for the page's top layer, and sits under the box there.
        // A browser without popovers, such as Safari before 17 or Firefox before 125, keeps it in the hero
        const canLift = "showPopover" in HTMLElement.prototype
        const isLifted = (menu: HTMLElement) => canLift && menu.matches(":popover-open")
        const placeLifted = (menu: HTMLElement) => {
            const box = menu.parentElement!.getBoundingClientRect()
            menu.style.top = `${box.bottom + 4}px`
            menu.style.right = `${document.documentElement.clientWidth - box.right}px`
        }
        const lift = (menu: HTMLElement, lifted: boolean) => {
            if (!lifted) {
                if (isLifted(menu)) menu.hidePopover()
                menu.removeAttribute("popover")
                menu.style.removeProperty("top")
                menu.style.removeProperty("right")
                return
            }
            menu.popover = "manual"
            menu.showPopover()
            placeLifted(menu)
            const below = menu.getBoundingClientRect().bottom - window.innerHeight
            if (below > 0) window.scrollBy({ top: below + 8, behavior: "instant" })
        }
        const overlaps = (a: DOMRect, b: DOMRect) => a.bottom > b.top && a.top < b.bottom && a.right > b.left && a.left < b.right

        // Opens under the box where that is inside the hero and the window. Otherwise over the box, or beside it, as on a
        // phone on its side, where that covers none of the hero's other controls, such as Get Started. So opening it never
        // scrolls the page. On a screen with room for none of these it opens under the box anyway and is brought into view,
        // leaving the hero, which clips what overflows it, when it would end below it. Measured each time, as the
        // command's length can change
        const fitMenu = () => {
            const menu = root.querySelector<HTMLElement>("[data-menu]")
            if (!menu || menu.hidden) return
            delete menu.dataset.up
            delete menu.dataset.side
            lift(menu, false)
            const hero = root.closest<HTMLElement>("[data-hero]")?.getBoundingClientRect()
            const top = Math.max(0, hero?.top ?? 0)
            const bottom = Math.min(window.innerHeight, hero?.bottom ?? window.innerHeight)
            const width = document.documentElement.clientWidth
            const controls = [...(root.closest("[data-hero]")?.querySelectorAll<HTMLElement>("a, button") ?? [])].filter((control) => !root.contains(control))
            const fits = () => {
                const box = menu.getBoundingClientRect()
                return box.top >= top && box.bottom <= bottom && box.left >= 0 && box.right <= width && !controls.some((control) => overlaps(control.getBoundingClientRect(), box))
            }
            if (fits()) return
            menu.dataset.up = ""
            if (fits()) return
            delete menu.dataset.up
            menu.style.setProperty("--side-room", `${width - menu.parentElement!.getBoundingClientRect().right}px`)
            menu.dataset.side = ""
            if (fits()) return
            delete menu.dataset.side
            if (menu.getBoundingClientRect().bottom <= (hero?.bottom ?? window.innerHeight)) menu.scrollIntoView({ block: "nearest" })
            else if (canLift) lift(menu, true)
            else menu.dataset.up = ""
        }
        window.addEventListener(
            "scroll",
            () => {
                const menu = root.querySelector<HTMLElement>("[data-menu]")
                if (menu && isLifted(menu)) placeLifted(menu)
            },
            { passive: true },
        )

        const render = () => {
            const manager = packageManagers.find((item) => item.id === pm) ?? packageManagers[0]
            const command = mode === "init" ? manager.init : manager.install
            const parts = split(command)
            for (const element of root.querySelectorAll<HTMLElement>("[data-tool]")) element.textContent = parts.tool
            for (const element of root.querySelectorAll<HTMLElement>("[data-pkg]")) element.innerHTML = parts.pkg.replace("/", "<wbr>/")
            for (const element of root.querySelectorAll<HTMLElement>("[data-tail]")) element.textContent = parts.tail
            fitMenu()
            for (const option of root.querySelectorAll<HTMLInputElement>('[data-group="pm"] input')) option.checked = option.value === pm
            for (const option of root.querySelectorAll<HTMLInputElement>('[data-group="mode"] input')) option.checked = option.value === mode
            const copy = root.querySelector<HTMLButtonElement>("[data-copy]")
            if (copy) copy.dataset.copy = command
        }

        const pick = root.querySelector<HTMLButtonElement>("[data-pick]")
        const menu = root.querySelector<HTMLElement>("[data-menu]")
        const setOpen = (open: boolean) => {
            if (!pick || !menu) return
            if (!open) lift(menu, false)
            menu.hidden = !open
            pick.setAttribute("aria-expanded", open ? "true" : "false")
            if (open) fitMenu()
        }
        pick?.addEventListener("click", () => setOpen(menu?.hidden !== false))
        document.addEventListener("pointerdown", (event) => {
            if (menu && !menu.hidden && !root.contains(event.target as Node)) setOpen(false)
        })
        root.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && menu && !menu.hidden) {
                setOpen(false)
                pick?.focus()
            }
        })

        for (const option of root.querySelectorAll<HTMLInputElement>('[data-group="pm"] input')) {
            option.addEventListener("change", () => {
                if (!isManager(option.value)) return
                pm = option.value
                write(pmKey, pm)
                render()
                window.dispatchEvent(new CustomEvent("fluxerly:pm", { detail: pm }))
            })
        }
        for (const option of root.querySelectorAll<HTMLInputElement>('[data-group="mode"] input')) {
            option.addEventListener("change", () => {
                mode = option.value === "init" ? "init" : "install"
                write(modeKey, mode)
                render()
            })
        }

        // The install section at the bottom of the page shares the same choice
        window.addEventListener("fluxerly:pm", (event) => {
            const next = (event as CustomEvent).detail
            if (isManager(next) && next !== pm) {
                pm = next
                render()
            }
        })

        const copy = root.querySelector<HTMLButtonElement>("[data-copy]")
        const status = root.querySelector<HTMLElement>("[data-copy-status]")
        let reset = 0
        copy?.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(copy.dataset.copy ?? "")
            } catch (error) {
                reportCopyFailed(error)
                return
            }
            copy.dataset.copied = "true"
            window.dispatchEvent(new Event("fluxerly:copied"))
            if (status) status.textContent = "Copied"
            window.clearTimeout(reset)
            reset = window.setTimeout(() => {
                delete copy.dataset.copied
                if (status) status.textContent = ""
            }, 1800)
        })

        render()
    }
</script>

<style>
    /* The coin and the chip rest on the water, lower edges on the surface, reflections below */
    .row {
        --coin: clamp(40px, min(2.5cqw, 4.4cqh), 46px);

        position: absolute;
        z-index: 3;
        left: var(--frame-inline);
        top: calc(var(--horizon) - var(--coin) + 1px);
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    /* The npm registry, where the SDK lives. Red is its own color */
    .coin {
        position: relative;
        display: grid;
        flex: none;
        place-items: center;
        width: var(--coin);
        height: var(--coin);
        color: #fff5f6;
        background:
            radial-gradient(circle at 34% 26%, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0) 42%),
            linear-gradient(180deg, #e2505f, #a51d38 70%, #7d1129);
        border: 1px solid rgb(255 190 200 / 0.55);
        border-radius: 50%;
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.3),
            inset 0 -6px 10px -6px rgb(60 4 18 / 0.7),
            0 8px 24px -8px rgb(226 80 95 / 0.65),
            0 0 0 1px rgb(4 5 26 / 0.4);
        transition:
            border-color var(--speed-fast) ease,
            box-shadow var(--speed-normal) ease;
    }

    a.coin:hover,
    a.coin:focus-visible {
        border-color: rgb(255 210 216 / 0.85);
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.38),
            inset 0 -6px 10px -6px rgb(60 4 18 / 0.7),
            0 8px 28px -6px rgb(226 80 95 / 0.9),
            0 0 0 1px rgb(4 5 26 / 0.4);
    }

    .npm-mark {
        width: 48%;
        height: 48%;
        fill: currentColor;
        filter: drop-shadow(0 1px 1px rgb(60 4 18 / 0.5));
    }

    .chip-wrap {
        position: relative;
    }

    .chip {
        display: flex;
        align-items: center;
        gap: 2px;
        height: var(--coin);
        padding: 0 6px 0 18px;
        background:
            linear-gradient(180deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0) 55%),
            rgb(5 7 28 / 0.88);
        border: 1px solid rgb(170 200 255 / 0.28);
        border-radius: var(--corner-medium);
        corner-shape: squircle;
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.12),
            0 14px 34px -20px rgb(0 0 0 / 0.9);
        backdrop-filter: blur(12px);
    }

    code {
        /* Room for the longest command, so the chip and its buttons never move when the command changes */
        min-width: 39ch;
        padding-right: 10px;
        font-family: var(--font-mono);
        font-size: clamp(15px, min(0.81cqw, 1.44cqh), 15.5px);
        color: var(--color-ink);
        white-space: nowrap;
    }

    .muted {
        color: rgb(195 200 230 / 0.78);
    }

    .tool-button {
        position: relative;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        color: var(--color-muted);
        background: none;
        border: 0;
        border-radius: var(--corner-medium);
        corner-shape: squircle;
        cursor: pointer;
        transition:
            color var(--speed-fast) ease,
            background-color var(--speed-fast) ease;
    }

    .tool-button:hover,
    .tool-button[aria-expanded="true"] {
        color: var(--color-ink);
        background: rgb(195 200 230 / 0.1);
    }

    /* The caret points along the water to where the menu opens, and back when it is open */
    .pick :global(svg) {
        transition: transform var(--speed-normal) ease;
    }

    .pick[aria-expanded="true"] :global(svg) {
        transform: rotate(180deg);
    }

    .copy :global(svg) {
        grid-area: 1 / 1;
        transition:
            opacity var(--speed-fast) ease,
            transform var(--speed-normal) ease;
    }

    .copy :global(.icon-done) {
        color: var(--color-cyan);
        opacity: 0;
        transform: scale(0.7);
    }

    .copy[data-copied] :global(.icon-copy) {
        opacity: 0;
        transform: scale(0.7);
    }

    .copy[data-copied] :global(.icon-done) {
        opacity: 1;
        transform: none;
    }

    /* Still turns the caret, swaps the copy icons and opens the menu at once */
    .row[data-still] :is(.pick, .copy) :global(svg),
    .row[data-still] .menu {
        transition: none;
    }

    /* The menu continues the chip to the right along the water, the same height, the same surface.
       It floats over the scene and never takes space in the row */
    .menu {
        position: absolute;
        left: calc(100% + 10px);
        bottom: 0;
        z-index: 4;
        display: flex;
        align-items: center;
        gap: 10px;
        height: var(--coin);
        padding: 0 8px;
        background:
            linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0) 55%),
            rgb(5 7 28 / 0.9);
        border: 1px solid rgb(170 200 255 / 0.26);
        border-radius: var(--corner-medium);
        corner-shape: squircle;
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.1),
            0 14px 34px -20px rgb(0 0 0 / 0.9);
        backdrop-filter: blur(12px);
        transition:
            opacity var(--speed-fast) ease,
            transform var(--speed-normal) cubic-bezier(0.2, 0.7, 0.2, 1),
            display var(--speed-normal) allow-discrete;
    }

    /* Lifted out of the hero onto the top layer, placed by script */
    .menu:popover-open {
        position: fixed;
        inset: auto;
        margin: 0;
    }

    .menu[hidden] {
        display: none;
        opacity: 0;
        transform: translateX(-8px);
    }

    @starting-style {
        .menu {
            opacity: 0;
            transform: translateX(-8px);
        }
    }

    .menu-row {
        display: flex;
        min-inline-size: 0;
        gap: 2px;
        margin: 0;
        padding: 2px;
        border: 0;
        background: rgb(255 255 255 / 0.04);
        border-radius: var(--corner-round);
    }

    .menu-divider {
        width: 1px;
        height: 22px;
        background: rgb(170 200 255 / 0.2);
    }

    .option {
        position: relative;
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding-inline: 12px;
        font: inherit;
        font-size: var(--type-small);
        font-weight: var(--weight-medium);
        line-height: 1;
        color: rgb(195 200 230 / 0.78);
        background: none;
        border: 0;
        border-radius: var(--corner-round);
        cursor: pointer;
        transition:
            color var(--speed-fast) ease,
            background-color var(--speed-fast) ease;
    }

    .option:hover {
        color: var(--color-ink);
    }

    .option:has(input:checked) {
        color: #06101a;
        background: linear-gradient(180deg, var(--color-cyan-light), var(--color-cyan));
    }

    .option:has(input:focus-visible) {
        outline: 2px solid var(--color-cyan);
        outline-offset: 2px;
    }

    .option input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    /* Mirrored around the water line and softened by it */
    .reflection {
        position: absolute;
        left: 0;
        top: calc(100% - 2px);
        display: flex;
        align-items: flex-start;
        gap: 12px;
        opacity: 0.22;
        transform: scaleY(-1);
        filter: blur(1.6px) url(#still-ripple);
        mask-image: linear-gradient(to top, #000 10%, transparent 90%);
        pointer-events: none;
        user-select: none;
    }

    .reflection .chip {
        backdrop-filter: none;
    }

    /* The options reach 44 px for a finger, without growing on screen */
    @media (any-pointer: coarse) {
        .option::before {
            content: "";
            position: absolute;
            inset: -8px 0;
        }
    }

    /* Where the menu's two groups wrap onto two rows, the line between them has nothing to divide */
    @media (max-width: 374px) {
        .menu {
            row-gap: 14px;
        }

        .menu-divider {
            display: none;
        }
    }

    /* The narrowest phones keep the menu on one row with tighter options, so it fits under the box on the first screen */
    @media (max-width: 359px) {
        .option {
            padding-inline: 7px;
        }
    }

    @media (max-width: 899px), (max-height: 480px), (max-aspect-ratio: 4/5) {
        /* The coin stays beside the chip, never alone on its own row */
        .row {
            position: relative;
            left: auto;
            top: auto;
            align-items: center;
            justify-content: center;
            max-width: 100%;
        }

        /* A phone is narrower than the longest command, so the command breaks at its spaces instead of running off the screen */
        .chip-wrap {
            min-width: 0;
            max-width: 100%;
        }

        .chip {
            height: auto;
            min-height: var(--coin);
            /* The command's lines keep the same clear room from the edge as a command chip's */
            padding-block: 8px;
        }

        code {
            min-width: 0;
            line-height: 1.2;
            white-space: normal;
            text-align: left;
        }

        /* The buttons sit in that room, so a one line command's box stays as tall as the coin */
        .tool-button {
            flex: none;
            margin-block: -8px;
        }

        .reflection {
            display: none;
        }

        /* Stacked layout: the menu opens under the chip instead of beside it, its two groups wrapping where they don't fit.
           It is kept low, so it fits under the box in the hero of the smallest phones, and its options reach 44 px for a
           finger with their clear layer */
        .menu {
            left: auto;
            right: 0;
            bottom: auto;
            top: calc(100% + 4px);
            flex-wrap: wrap;
            justify-content: flex-end;
            width: max-content;
            max-width: calc(100vw - 2 * var(--page-margin));
            height: auto;
            padding-block: 3px;
        }

        /* Without room under the row, which script measures as it opens, the menu opens over it */
        .menu[data-up] {
            top: auto;
            bottom: calc(100% + 4px);
        }

        /* Nor over it, as on a phone on its side 320 px tall: beside the row, level with the box as on a wide screen, its
           two groups on two rows with their reach for a finger apart, within the room script measures to the window's edge */
        .menu[data-side] {
            left: calc(100% + 10px);
            right: auto;
            top: auto;
            bottom: 0;
            row-gap: 14px;
            justify-content: flex-start;
            max-width: calc(var(--side-room) - 10px - var(--page-margin));
        }

        .menu[data-side] .menu-divider {
            display: none;
        }

        .menu[data-side] .option {
            padding-inline: 7px;
        }
    }
</style>
