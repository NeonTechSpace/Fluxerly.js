---
import { ClientRouter } from 'astro:transitions'
import '@fontsource-variable/outfit'
import '../styles/global.css'
import '../styles/commands.css'
import '../styles/examples.css'
// Alternates point programs such as AI tools to plain-text versions of the page
const { title, alternates = [] } = Astro.props as { title: string; alternates?: { href: string; type: string; title: string }[] }
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Fluxerly.js</title>
    {alternates.map((alternate) => <link rel="alternate" type={alternate.type} href={alternate.href} title={alternate.title} />)}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#docs-page-start">Skip to content</a>
    <slot />
    <script>
      import { setupCommandPreferences } from './command-preferences'
      import { setupReferencePreviews } from './reference-previews'
      import { setupExamplePreferences } from './example-preferences'
      import { setupPageMarkdown } from './page-markdown'
      setupCommandPreferences()
      setupReferencePreviews()
      setupExamplePreferences()
      setupPageMarkdown()
    </script>
  </body>
</html>
