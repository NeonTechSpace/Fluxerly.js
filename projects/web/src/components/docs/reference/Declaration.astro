---
// A function, variable, type alias or interface, documented in full where its category page lists it
import type { Declaration } from "../../../lib/reference"
import { declarationHtml, fitted } from "../../../lib/reference-format"
import Callable from "./Callable.astro"
import DocText from "./DocText.astro"
import Heading from "./Heading.astro"
import Members from "./Members.astro"

interface Props {
    item: Declaration
}

const { item } = Astro.props
// A function prints its signatures instead, so every other kind has a declaration
const kind = item.kind === "function" ? "variable" : item.kind
---

<article class="ref-symbol">
    <Heading level={3} id={item.anchor} code>{item.name}</Heading>
    {
        item.kind === "function" ? (
            item.signatures?.map((signature) => <Callable signature={signature} name={item.name} self={item.url} />)
        ) : (
            <>
                <DocText doc={item.doc} part="lead" self={item.url} />
                <pre class="ref-sig"><code set:html={fitted((width) => declarationHtml(kind, item.name, { type: item.type, tp: item.tp, extends: item.extends, implements: item.implements, const: item.const }, width))} /></pre>
                <DocText doc={item.doc} part="body" self={item.url} />
                <DocText doc={item.doc} part="rest" self={item.url} />
                {(!!item.members?.length || !!item.inherited?.length) && <Members members={item.members ?? []} inherited={item.inherited} level={4} />}
            </>
        )
    }
</article>
