---
// The first visit's one tip, on whichever page the visit starts: the page dims around the header's motion switch and one
// short line points at it. It shows once and only while the site is moving, since a visitor who has it still has found the
// switch or asked their system for less motion. Any press, Escape or a scroll puts it away and the page goes on as usual
---

<div class="tour" popover="manual" data-tour>
    <div class="tour-catch" data-tour-catch></div>
    <div class="tour-light"></div>
    <div class="tour-card" role="dialog" aria-labelledby="tour-words" tabindex="-1" data-tour-card>
        <p class="tour-words" id="tour-words">Prefer it still? Press here</p>
    </div>
</div>

<script>
    import { getExperience, prefersReducedMotion, subscribeExperience } from "../lib/experience"

    const seenKey = "fluxerly.tour.v1"
    // The page has a moment to arrive before it darkens
    const openDelay = 1100
    const closeTime = 360
    // How far a scroll goes before the reader has clearly moved on
    const scrollAway = 24
    const pad = 4
    const edge = 12
    const gap = 12

    const tour = document.querySelector<HTMLElement>("[data-tour]")
    const toggle = document.querySelector<HTMLElement>(".motion")
    const header = document.querySelector<HTMLElement>("[data-site-header]")

    // Blocked storage can't remember the tip, so it counts as seen rather than coming back on every page
    const seen = () => {
        try {
            return localStorage.getItem(seenKey) !== null
        } catch {
            return true
        }
    }

    if (tour && toggle && header && "showPopover" in tour && !seen() && getExperience() !== "still" && !prefersReducedMotion()) start(tour, toggle, header)

    function start(tour: HTMLElement, toggle: HTMLElement, header: HTMLElement) {
        const catcher = tour.querySelector<HTMLElement>("[data-tour-catch]")!
        const card = tour.querySelector<HTMLElement>("[data-tour-card]")!
        let open = false
        let done = false
        let timer = 0
        let closeTimer = 0
        let fromY = 0
        let before: Element | null = null

        const hasOpenDialog = () => document.querySelector("dialog[open]") !== null
        const isEditable = (target: EventTarget | null) =>
            target instanceof Element && Boolean(target.closest('input, textarea, select, [contenteditable="true"], [contenteditable=""], .cm-editor'))
        let waitingForBlur = false
        let blurTimer = 0

        const remember = () => {
            done = true
            try {
                localStorage.setItem(seenKey, "1")
            } catch {
                // Blocked between the two reads: it stays on this page only
            }
        }

        // Places everything around the switch. The page's zoom on wide screens also scales what is placed here, so
        // screen pixels are divided back out of it
        const place = () => {
            const zoom = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--page-zoom")) || 1
            const box = toggle.getBoundingClientRect()
            const x = box.left / zoom
            const y = box.top / zoom
            const w = box.width / zoom
            const h = box.height / zoom
            const screen = window.innerWidth / zoom
            tour.style.setProperty("--x", `${x - pad}px`)
            tour.style.setProperty("--y", `${y - pad}px`)
            tour.style.setProperty("--w", `${w + pad * 2}px`)
            tour.style.setProperty("--h", `${h + pad * 2}px`)
            const left = Math.max(edge, Math.min(screen - edge - card.offsetWidth, x + w + pad - card.offsetWidth))
            card.style.left = `${left}px`
            card.style.top = `${y + h + pad + gap}px`
            card.style.setProperty("--caret", `${x + w / 2 - left}px`)
            // The switch's own place is left open, so it can be pressed through the dark
            const [x1, y1, x2, y2] = [x - pad, y - pad, x + w + pad, y + h + pad]
            catcher.style.clipPath = `polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, ${x1}px ${y1}px, ${x1}px ${y2}px, ${x2}px ${y2}px, ${x2}px ${y1}px, ${x1}px ${y1}px)`
        }

        const onKey = (event: KeyboardEvent) => {
            if (event.key === "Escape") {
                close()
                return
            }
            if (event.key === "Tab") {
                event.preventDefault()
                const focusables = [...card.querySelectorAll<HTMLElement>('a[href], button:not(:disabled), [tabindex]:not([tabindex="-1"])')]
                if (focusables.length === 0) {
                    card.focus({ preventScroll: true })
                    return
                }
                const first = focusables[0]!
                const last = focusables[focusables.length - 1]!
                if (event.shiftKey) (document.activeElement === first || !card.contains(document.activeElement) ? last : first).focus({ preventScroll: true })
                else (document.activeElement === last || !card.contains(document.activeElement) ? first : last).focus({ preventScroll: true })
            }
        }
        const onScroll = () => {
            if (Math.abs(window.scrollY - fromY) > scrollAway) close()
        }

        const onDialogClose = () => {
            if (hasOpenDialog()) return
            document.removeEventListener("close", onDialogClose, true)
            if (!done && !open) show()
        }

        const onEditorBlur = () => {
            window.clearTimeout(blurTimer)
            // Focus moves to the newly focused element right after focusout, so check on the next tick
            blurTimer = window.setTimeout(() => {
                if (done || open || isEditable(document.activeElement)) return
                waitingForBlur = false
                document.removeEventListener("focusout", onEditorBlur, true)
                show()
            }, 0)
        }

        const dialogObserver = new MutationObserver(() => {
            if (open && hasOpenDialog()) close(false, true)
        })

        const close = (restoreFocus = true, immediate = false) => {
            if (!open) return
            open = false
            dialogObserver.disconnect()
            window.removeEventListener("resize", place)
            window.removeEventListener("scroll", onScroll)
            document.removeEventListener("keydown", onKey)
            tour.removeAttribute("data-on")
            if (tour.contains(document.activeElement)) (document.activeElement as HTMLElement).blur()
            if (restoreFocus && before instanceof HTMLElement && before !== document.body) before.focus({ preventScroll: true })
            window.clearTimeout(closeTimer)
            if (immediate) {
                if (tour.matches(":popover-open")) tour.hidePopover()
            } else {
                closeTimer = window.setTimeout(() => {
                    if (!open && tour.matches(":popover-open")) tour.hidePopover()
                }, closeTime)
            }
        }

        const show = () => {
            if (open || done) return
            // Do not open the spotlight over an open modal dialog, wait until no dialog is open
            if (hasOpenDialog()) {
                document.addEventListener("close", onDialogClose, true)
                return
            }
            // Do not steal focus while typing in a form field or the Playground editor
            if (isEditable(document.activeElement)) {
                if (!waitingForBlur) {
                    waitingForBlur = true
                    document.addEventListener("focusout", onEditorBlur, true)
                }
                return
            }
            // Read down the page already, the header has gone, and the switch with it. The tip waits for it to come back
            if (header.hasAttribute("data-hidden") || toggle.getBoundingClientRect().width === 0) {
                window.addEventListener("scroll", wait, { passive: true })
                return
            }
            remember()
            open = true
            before = document.activeElement
            fromY = window.scrollY
            window.clearTimeout(closeTimer)
            tour.showPopover()
            place()
            dialogObserver.observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ["open"] })
            // A frame in the closed state first, so the dark and the card have somewhere to come from
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (!open) return
                    tour.setAttribute("data-on", "")
                    card.focus({ preventScroll: true })
                })
            })
            window.addEventListener("resize", place)
            window.addEventListener("scroll", onScroll, { passive: true })
            document.addEventListener("keydown", onKey)
        }
        const wait = () => {
            if (header.hasAttribute("data-hidden")) return
            window.removeEventListener("scroll", wait)
            show()
        }

        const onDismiss = () => {
            if (open) close(true, true)
        }
        window.addEventListener("fluxerly:dismiss-tour", onDismiss)

        catcher.addEventListener("click", () => close())
        card.addEventListener("click", () => close())
        const interaction = new AbortController()
        let interacted = false
        let moveOrigin: [number, number] | null = null

        const arm = () => {
            if (done || open || timer) return
            timer = window.setTimeout(show, openDelay)
        }

        const onInteract = (event: Event) => {
            if (!event.isTrusted || interacted || done) return
            if (event.type === "pointermove") {
                const { clientX, clientY } = event as PointerEvent
                // Browsers synthesize a pointermove at (0, 0) during layout with no real input, so require actual travel
                if (!moveOrigin) {
                    moveOrigin = [clientX, clientY]
                    return
                }
                if (Math.hypot(clientX - moveOrigin[0], clientY - moveOrigin[1]) < 6) return
            }
            interacted = true
            interaction.abort()
            if (document.readyState === "complete") arm()
            else window.addEventListener("load", arm, { once: true })
        }

        // Pressing the switch does what the tip says. There is nothing more to tell, before or after it shows
        subscribeExperience(() => {
            interaction.abort()
            window.clearTimeout(timer)
            window.clearTimeout(blurTimer)
            waitingForBlur = false
            window.removeEventListener("load", arm)
            window.removeEventListener("scroll", wait)
            document.removeEventListener("keydown", onKey)
            document.removeEventListener("close", onDialogClose, true)
            document.removeEventListener("focusout", onEditorBlur, true)
            if (open) close()
            else remember()
        })

        // Wait for a first real user interaction before arming the spotlight so zero-interaction
        // arrivals and search-engine snapshots see the unobstructed page
        for (const kind of ["pointermove", "pointerdown", "touchstart", "wheel", "keydown"] as const) {
            window.addEventListener(kind, onInteract, { passive: true, signal: interaction.signal })
        }
    }
</script>

<style>
    .tour {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: 0;
        overflow: clip;
        color: var(--color-ink);
        background: none;
        border: 0;
        pointer-events: none;
    }

    .tour:not(:popover-open) {
        display: none;
    }

    /* Takes a press anywhere but on the switch */
    .tour-catch {
        position: absolute;
        inset: 0;
        pointer-events: auto;
    }

    /* The dark is the shadow of the switch's own lit place, so the hole has the switch's corners */
    .tour-light {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: var(--w);
        height: var(--h);
        border-radius: calc(var(--corner-medium) + 4px);
        corner-shape: squircle;
        box-shadow:
            0 0 0 1px rgb(70 227 239 / 0.7),
            0 0 0 200vmax rgb(2 3 18 / 0.62);
        opacity: 0;
        transition: opacity var(--speed-slow) ease-out;
    }

    /* The look of the header's own tooltips, with the same notch pointing up at the switch */
    .tour-card {
        position: absolute;
        width: max-content;
        padding: 7px 12px;
        cursor: pointer;
        background: rgb(8 11 40 / 0.96);
        border: 1px solid rgb(160 190 255 / 0.24);
        border-radius: var(--corner-medium);
        corner-shape: squircle;
        outline: none;
        pointer-events: auto;
        opacity: 0;
        transform: translate3d(0, -4px, 0);
        transition:
            opacity var(--speed-normal) ease-out,
            transform var(--speed-normal) ease-out;
    }

    .tour-card::before {
        content: "";
        position: absolute;
        top: -5px;
        left: calc(var(--caret, 50%) - 4.5px);
        width: 9px;
        height: 9px;
        background: rgb(8 11 40);
        border: 1px solid rgb(160 190 255 / 0.24);
        border-width: 1px 0 0 1px;
        transform: rotate(45deg);
    }

    .tour-words {
        margin: 0;
        font-size: var(--type-small);
        font-weight: var(--weight-medium);
        line-height: 1.3;
        color: var(--color-ink);
    }

    .tour[data-on] .tour-light {
        opacity: 1;
    }

    .tour[data-on] .tour-card {
        opacity: 1;
        transform: none;
    }
</style>
