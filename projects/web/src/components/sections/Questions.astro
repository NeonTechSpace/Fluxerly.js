---
import { ArrowRightIcon } from "@phosphor-icons/react/ssr"
import Companion from "./Companion.astro"
import Depth from "./Depth.astro"
import { guide } from "../../lib/links"

export interface Question {
    // The anchor after #question-, named for the topic so a link keeps its question when the list is reordered
    id: string
    question: string
    // Static HTML, for inline code
    answer: string
    // A question without a link ends with its answer
    href?: string
    link?: string
}

// Fifteen questions read better as three short lists. The order of the list below decides nothing else
const groups = [
    { title: "Using Fluxerly", ids: ["slash-commands", "effect", "intents", "node", "voice", "rate-limits"] },
    { title: "How It Behaves", ids: ["stable", "results", "testing", "message-methods", "missing-method"] },
    { title: "Fluxerly and AI", ids: ["built-with-ai", "why-ai", "trust-ai-code", "avoid-ai"] },
]

export const questions: Question[] = [
    {
        id: "slash-commands",
        question: "Where Are Slash Commands?",
        answer: 'Fluxer does not let bots register slash commands yet. Fluxerly will add them as soon as Fluxer supports them. Until then, Fluxerly commands are prefix commands, messages such as <code class="inline-code">!ping</code> that start with a chosen prefix, with typed arguments, guards, cooldowns, groups and generated help',
        href: guide("commands"),
        link: "Commands Guide",
    },
    {
        id: "effect",
        question: "Do I Have to Learn Effect?",
        answer: 'No. The default entry point uses <code class="inline-code">async</code> and <code class="inline-code">await</code> with Results. The SDK uses Effect inside, and npm, pnpm and Bun install it automatically, while the Effect entry point is there for applications that already use it',
        href: guide("effect-first-bot"),
        link: "First Effect Bot",
    },
    {
        id: "stable",
        question: "Is It Stable?",
        answer: "Yes. Stable releases follow Epoch Semantic Versioning, so only a new major version or epoch can break existing code, and minor and patch releases are safe to take. Nightly builds can include breaking changes at any time",
        href: guide("support-and-compatibility"),
        link: "Support and Compatibility",
    },
    {
        id: "intents",
        question: "Do I Have to Enable Intents or Events?",
        answer: 'No. Fluxer has no gateway intents. Messages arrive when the bot can read the channel. Presence updates for chosen community members also need <code class="inline-code">client.presence.setMembers</code> with their IDs',
        href: guide("configuration", "events-and-the-gateway"),
        link: "Events and the Gateway",
    },
    {
        id: "node",
        question: "Which Node.js and Module System?",
        answer: 'Node.js with ES modules only. JavaScript needs no compiler, and TypeScript projects add TypeScript 7 and <code class="inline-code">@types/node</code>. The supported Node.js and TypeScript versions are listed in the support guide',
        href: guide("support-and-compatibility"),
        link: "Support and Compatibility",
    },
    {
        id: "results",
        question: "Why Do Calls Return a Result Instead of Throwing?",
        answer: 'Expected failures such as a missing permission, a network error or a rate limit stay visible in the return type, so they are handled where they happen. Invalid options still throw at once, and <code class="inline-code">orThrow</code> is there for code that prefers exceptions',
        href: guide("reliability"),
        link: "Reliability Guide",
    },
    {
        id: "voice",
        question: "Can It Join Voice?",
        answer: "Not yet. Fluxerly waits for Fluxer's new voice system and does not support voice over LiveKit. Fluxer is replacing LiveKit with its own voice system, which should arrive soon, and bot voice will come with it. Until then, voice states, member voice controls such as move, mute, deafen and disconnect, voice notes, and audio or video attachments work",
        href: guide("guilds-and-permissions", "voice-controls-versus-a-voice-connection"),
        link: "Voice Controls",
    },
    {
        id: "built-with-ai",
        question: "Is Fluxerly Built with AI?",
        answer: "Yes. Fluxerly is built with AI as a core part of its workflow, not an afterthought. Automation handles implementation, broad research across Fluxer's source and parallel passes at a pace hand-typing cannot match, which lets Fluxerly stay closer to upstream changes, ship deeper coverage and keep maintainers focused on architecture, standards and priorities",
        href: "#quality",
        link: "Quality, Speed and Security",
    },
    {
        id: "why-ai",
        question: "Why Not Write Everything by Hand?",
        answer: "Writing every line by hand is not inherently better software engineering. Tracking a fast-moving platform takes constant reading of upstream commits, parallel audits, exhaustive edge-case coverage and repetitive contract updates that automation handles faster and more thoroughly than manual effort alone. That extra reach shows up directly in fewer missed edge cases, quicker fixes and more complete documentation",
    },
    {
        id: "trust-ai-code",
        question: "How Is AI-Written Code Verified?",
        answer: "The same way any reliable software is verified: By what it proves under test, not by how it was typed. Because automation makes thorough testing and multi-pass review cheap to run on every change, work goes through strict type checks, contract checks against Fluxer's pinned source, isolated fuzz and simulation runs, independent review passes and live sandbox runs against Fluxer before a stable release ships",
        href: "#quality",
        link: "Quality, Speed and Security",
    },
    {
        id: "avoid-ai",
        question: "Does Fluxerly Require AI Tools to Use?",
        answer: "No. Everything in the SDK works cleanly without an AI tool: Guides are organized by task with copyable examples, hover definitions explain terms inline, and strict TypeScript types show valid options and errors directly in the editor. For developers who do use coding agents, Fluxerly also ships ready-to-use agent rules, machine-readable docs and a CLI setup command",
        href: guide("quick-start"),
        link: "Quick Start",
    },
    {
        id: "rate-limits",
        question: "What About Rate Limits?",
        answer: 'Usually. When Fluxer answers with HTTP 429 and names a delay, the SDK waits and sends again if the wait fits the request\'s deadline. A webhook message, or a message on an instance without direct uploads, that carries a Blob, File or stream attachment fails instead, because its body cannot be sent twice. Waits of a second or more are logged as warnings with the code <code class="inline-code">ratelimit.wait</code>',
        href: guide("reliability", "limits-and-retry-rules"),
        link: "Limits and Retry Rules",
    },
    {
        id: "testing",
        question: "How Do I Test Without a Token?",
        answer: "The testing entry point creates a real client connected to an in-memory Fluxer. Tests deliver events, answer requests and check what the bot sent, with no network and no account",
        href: guide("testing"),
        link: "Testing Guide",
    },
    {
        id: "message-methods",
        question: "Why Do Messages Have No Methods?",
        answer: 'Messages are plain, read-only data, so no network call hides behind a property. A handler receives a <code class="inline-code">reply</code> function, and <code class="inline-code">client.messages.send</code> sends to any channel',
        href: guide("messages"),
        link: "Messages Guide",
    },
    {
        id: "missing-method",
        question: "What if a Fluxer Route Has No Method?",
        answer: 'The <code class="inline-code">client.rest.call</code> method reaches every route that accepts a bot token, typed with Fluxer\'s own field names, so a misspelled field fails to compile. For a route newer than the SDK, <code class="inline-code">client.rest.request</code> sends it untyped. Each gateway event the bot receives also arrives as the <code class="inline-code">raw</code> event, typed when Fluxer\'s documentation describes it',
        href: "/raw/",
        link: "Raw Access, Still Typed",
    },
]

export const homeFaq = questions.map(({ question, answer }) => ({ question, answer: answer.replace(/<[^>]+>/g, "") }))

---

<section class="questions" id="questions" aria-labelledby="questions-title" data-accent="violet">
    <!-- The violet crescent of the conductor's face, far out in the left margin -->
    <Depth name="crescent-violet" side="left" top="68%" width={156} depth={0.9} />
    <div class="split">
        <div class="intro" data-rise>
            <h2 class="section-title" id="questions-title"><span class="station" data-station="questions" aria-hidden="true"></span>The Questions That <span class="hi">Come Up First</span></h2>
            <p class="lead">Short answers to common questions, with links to go deeper</p>
            <p class="more">
                <a class="prose-link" href={guide("faq")}>More Answers in the FAQ</a>
                <a class="prose-link" href={guide("where-do-i")}>Where Do I…?</a>
            </p>
            <Companion class="keepsake" name="support-lifebuoy" alt="A lifebuoy ring with rope" size={240} />
        </div>
        {
            <div class="body list" data-rise>
                {groups.map((group) => (
                    <div class="group">
                    <h3 class="group-title">{group.title}</h3>
                    {group.ids.map((id) => questions.find((question) => question.id === id)!).map((item) => (
                        <details class="item" name="question" id={`question-${item.id}`}>
                            <summary>
                                <span class="question">{item.question}</span>
                                <svg class="mark" viewBox="0 0 20 14" aria-hidden="true" focusable="false">
                                    <path d="M1.5 7c2.3-2.9 4.6-2.9 6.9 0s4.6 2.9 6.9 0 2.5-2.1 3.2-1.4" />
                                </svg>
                            </summary>
                            <div class="answer">
                                <p set:html={item.answer} />
                                {item.href && (
                                    <a class="prose-link go-link" href={item.href}>
                                        {item.link}
                                        <ArrowRightIcon size={15} weight="bold" aria-hidden="true" />
                                    </a>
                                )}
                            </div>
                        </details>
                    ))}
                    </div>
                ))}
            </div>
        }
    </div>
</section>

<script>
    // A link to one question opens its answer and brings it into view
    const openQuestion = (id: string) => {
        const item = document.getElementById(id)
        if (!(item instanceof HTMLDetailsElement)) return
        item.open = true
        item.scrollIntoView({ behavior: "instant", block: "start" })
        item.querySelector("summary")?.focus({ preventScroll: true })
    }

    if (location.hash.startsWith("#question-")) openQuestion(location.hash.slice(1))

    // Opening a question closes the one before it, and answers glide open and shut. When the closing one sits above, the pressed
    // question rises with it, so its own answer has room on screen and the page stays where the reader left it. The page only
    // follows if the question would otherwise slide under the header. Any scrolling by the reader ends this at once
    const settling = 460
    const clearOfHeader = 96
    // A second press takes over from the first, so only one of them ever moves the page
    let latestPress = 0
    for (const summary of document.querySelectorAll<HTMLElement>(".item summary")) {
        summary.addEventListener("click", () => {
            const started = performance.now()
            const press = ++latestPress
            let expected = window.scrollY
            let calmFrames = 0
            // The browser's own scroll anchoring would scroll the page up to hold what's on screen
            const root = document.documentElement
            root.style.overflowAnchor = "none"
            const follow = () => {
                if (press !== latestPress) return
                // Phones round the scroll position to their pixels, so a small difference is not the reader scrolling
                const stillHere = Math.abs(window.scrollY - expected) <= 1.5
                const under = summary.getBoundingClientRect().top - clearOfHeader
                if (stillHere && under < -0.5) {
                    window.scrollBy({ top: under, behavior: "instant" })
                    expected = window.scrollY
                }
                // On a slow device the answers can start and finish late, so this also waits for several calm frames
                calmFrames = under < -0.5 ? 0 : calmFrames + 1
                if (stillHere && (performance.now() - started < settling || calmFrames < 8)) requestAnimationFrame(follow)
                else root.style.overflowAnchor = ""
            }
            requestAnimationFrame(follow)
        })
    }
</script>

<style>
    .group + .group {
        margin-top: 36px;
    }

    .group-title {
        margin: 0;
        padding: 0 16px 10px;
        font-size: var(--type-small);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-wide);
        color: var(--accent, var(--color-violet));
        border-bottom: 1px solid var(--color-divider);
    }

    /* The rows reach a little past the column on both sides, so an open row's highlight has room around its text
       and the row keeps its edges whether open or closed */
    .list {
        margin-inline: -16px;
    }


    .item {
        padding-inline: 16px;
        scroll-margin-top: 120px;
        border-bottom: 1px solid var(--color-divider);
    }

    .item[open] {
        background: linear-gradient(90deg, var(--accent-soft), transparent 60%);
        border-radius: var(--corner-medium);
        corner-shape: squircle;
    }

    @media (max-width: 899px) {
        .list {
            margin-inline: -12px;
        }

        .item {
            padding-inline: 12px;
        }

        .group-title {
            padding-inline: 12px;
        }
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 4px 20px 0;
        font-size: var(--type-lead);
        font-weight: var(--weight-medium);
        line-height: 1.4;
        color: var(--color-ink);
        list-style: none;
        border-radius: var(--corner-small);
        corner-shape: squircle;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover .question {
        color: #ffffff;
    }

    /* An open question is a wave. Answered, it settles into a flat line */
    .mark {
        flex: none;
        width: 20px;
        height: 14px;
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.7;
        stroke-linecap: round;
    }

    .mark path {
        d: path("M1.5 7c2.3-2.9 4.6-2.9 6.9 0s4.6 2.9 6.9 0 2.5-2.1 3.2-1.4");
        transition: d var(--speed-slow) cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .item[open] .mark path {
        d: path("M1.5 7c2.3 0 4.6 0 6.9 0s4.6 0 6.9 0 2.5 0 3.2 0");
    }

    /* An answer glides open and shut, so nothing around it jumps. Where a browser can't, it opens at once */
    .item {
        interpolate-size: allow-keywords;
    }

    .item::details-content {
        height: 0;
        overflow: clip;
        opacity: 0;
        transition:
            height var(--speed-slow) cubic-bezier(0.3, 0, 0.2, 1),
            opacity var(--speed-normal) ease,
            content-visibility var(--speed-slow) allow-discrete;
    }

    .item[open]::details-content {
        height: auto;
        opacity: 1;
    }

    /* Opening sends one ripple along the row from the wave mark */
    .item[open] summary::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: var(--corner-medium);
        corner-shape: squircle;
        background: linear-gradient(90deg, var(--accent-soft), transparent 55%);
        animation: question-ripple 700ms ease-out forwards;
        pointer-events: none;
    }

    summary {
        position: relative;
    }

    @keyframes question-ripple {
        from {
            opacity: 1;
            transform: scaleX(0);
            transform-origin: right;
        }
        to {
            opacity: 0;
            transform: scaleX(1);
            transform-origin: right;
        }
    }

    :global(.night[data-still]) .item[open] summary::after {
        animation: none;
        opacity: 0;
    }

    .answer {
        max-width: 60ch;
        padding: 0 32px 24px 0;
    }

    .answer p {
        margin: 0;
        font-size: var(--type-lead);
        line-height: 1.6;
        color: var(--color-muted);
        text-wrap: pretty;
    }

    .answer .go-link {
        margin-top: 12px;
    }

    .more {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
        margin: 28px 0 0;
        font-size: var(--type-body);
        font-weight: var(--weight-medium);
    }

    :global(.night[data-still]) .item::details-content,
    :global(.night[data-still]) .mark path {
        transition: none;
    }

</style>
