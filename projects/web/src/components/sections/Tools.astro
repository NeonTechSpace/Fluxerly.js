---
import { ArrowRightIcon } from "@phosphor-icons/react/ssr"
import CommandChip from "./CommandChip.astro"
import Companion from "./Companion.astro"
import { links } from "../../lib/links"

const code = (text: string) => `<code class="inline-code">${text}</code>`

// Each tool ends in the page it is read about, or the command that runs it
const items = [
    {
        title: "Browser SDK Playground",
        text: `Write and run real JavaScript, TypeScript and Effect bots in the browser on an in-memory Fluxer gateway with live 429, 403 and WebSocket fault injection, plus REST and WebSocket inspection`,
        href: links.playground,
        link: "Open the Playground",
    },
    {
        title: "Offline Setup Checks",
        text: `Run ${code("fluxerly doctor")} offline before a bot connects to catch Node.js, ESM, ${code("tsconfig.json")}, TypeScript 7, Effect peer, ${code(".gitignore")} and ${code(".env")} token prefix mistakes without printing secrets`,
        command: "npx --no fluxerly doctor",
    },
    {
        title: "Agent-Powered Triage",
        text: `Run ${code("fluxerly triage")} to bundle redacted project facts, the pinned Fluxer server commit and optional live traces for Antigravity, Claude Code, Codex, OpenCode, T3 Code or any other coding agent`,
        command: "npx --no fluxerly triage",
    },
    {
        title: "Docs, Source and Test Helpers",
        text: `Shipped TypeScript ${code("src/")} files, source maps, type docs and ${code("/testing")} plus ${code("/effect/testing")} entry points come in the package so editors show exact code and projects start with offline tests`,
        href: links.apiReference,
        link: "API Reference",
    },
    {
        title: "Agent Rules and Invite CLI",
        text: `Sync SDK rules into ${code("AGENTS.md")}, ${code("SKILL.md")}, Cursor, Claude and Gemini files with ${code("fluxerly agents")}, or generate bot invite URLs offline with ${code("fluxerly invite")}`,
        command: "npx --no fluxerly agents",
    },
]

// The tools in short, under the lead
const facts = ["Browser playground with fault injection", "Offline doctor setup checks", "Agent triage for any harness", "Docs, source and offline tests", "Agent rules and invite CLI"]
---

<section class="tools" id="tools" aria-labelledby="tools-title" data-accent="violet">
    <div class="split" data-side="right">
        <div class="intro" data-rise>
            <h2 class="section-title" id="tools-title"><span class="station" data-station="tools" aria-hidden="true"></span>Tools That Come <span class="hi">with the SDK</span></h2>
            <p class="lead">Editor docs, full source, test helpers, diagnostics CLI and agent rules all ship in the package you install</p>
            <ul class="facts">
                {
                    facts.map((fact) => (
                        <li>
                            <span class="wave-mark" aria-hidden="true" />
                            {fact}
                        </li>
                    ))
                }
            </ul>
            <Companion class="keepsake" name="toolbox" alt="An open toolbox holding a wrench and a small star vial" size={210} />
        </div>
        <ul class="body items" data-rise>
            {
                items.map((item) => (
                    <li class="item">
                        <span class="wave-mark" aria-hidden="true"></span>
                        <div class="content">
                            <h3>{item.title}</h3>
                            <p class="text" set:html={item.text} />
                            <div class="row">
                                {item.command && <CommandChip class="chip" command={item.command} />}
                                {item.href && (
                                    <a class="prose-link go-link" href={item.href}>
                                        {item.link}
                                        <ArrowRightIcon size={15} weight="bold" aria-hidden="true" />
                                    </a>
                                )}
                            </div>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    /* No margin reset here: on a phone the shared rule spaces the list from the lead */
    .items {
        padding: 0;
        list-style: none;
    }

    .item {
        display: flex;
        gap: 22px;
        padding: 30px 0 34px;
        border-top: 1px solid var(--color-divider);
    }

    .item:last-child {
        border-bottom: 1px solid var(--color-divider);
    }

    .item .wave-mark {
        margin-top: 8px;
    }

    .content {
        flex: 1;
        min-width: 0;
    }

    h3 {
        margin: 0;
        font-size: var(--type-title);
        font-weight: var(--weight-semibold);
        line-height: 1.3;
        color: var(--color-ink);
        text-wrap: balance;
    }

    .text {
        max-width: 58ch;
        margin: 10px 0 0;
        font-size: var(--type-lead);
        line-height: 1.6;
        color: var(--color-muted);
        text-wrap: pretty;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 24px;
        margin-top: 18px;
    }


    @media (max-width: 899px) {
        .item {
            gap: 16px;
        }
    }
</style>
