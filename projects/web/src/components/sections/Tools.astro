---
import { ArrowRightIcon } from "@phosphor-icons/react/ssr"
import CommandChip from "./CommandChip.astro"
import Companion from "./Companion.astro"
import { guide, links } from "../../lib/links"

const code = (text: string) => `<code class="inline-code">${text}</code>`

// Each tool ends in the page it is read about, or the command that runs it
const items = [
    {
        title: "Docs in Your Editor",
        text: "The documentation lives in the type declarations, so autocompletion in the editor shows the same text as the API reference",
        href: links.apiReference,
        link: "API Reference",
    },
    {
        title: "Test Helpers Included",
        text: `The ${code("/testing")} and ${code("/effect/testing")} entry points come with the SDK. A project from ${code("fluxerly init")} starts with its first test`,
        href: guide("testing"),
        link: "Testing Guide",
    },
    {
        title: "Rules for Coding Agents",
        text: `${code("fluxerly agents")} adds the SDK's rules to the ${code("AGENTS.md")} of a project that has the SDK installed, and the docs publish ${code("llms.txt")}. The rules are plain text a person can read too. Nothing here needs an AI tool`,
        command: "npx --no fluxerly agents",
    },
]

// The tools in short, under the lead
const facts = ["Documentation in the declarations", "Test helpers included", "Rules for coding agents"]
---

<section class="tools" id="tools" aria-labelledby="tools-title" data-accent="violet">
    <div class="split" data-side="right">
        <div class="intro" data-rise>
            <h2 class="section-title" id="tools-title"><span class="station" data-station="tools" aria-hidden="true"></span>Tools That Come <span class="hi">with the SDK</span></h2>
            <p class="lead">Editor documentation, test helpers and agent rules all come in the package you install</p>
            <ul class="facts">
                {
                    facts.map((fact) => (
                        <li>
                            <span class="wave-mark" aria-hidden="true" />
                            {fact}
                        </li>
                    ))
                }
            </ul>
            <Companion class="keepsake" name="toolbox" alt="An open toolbox holding a wrench and a small star vial" size={210} />
        </div>
        <ul class="body items" data-rise>
            {
                items.map((item) => (
                    <li class="item">
                        <span class="wave-mark" aria-hidden="true"></span>
                        <div class="content">
                            <h3>{item.title}</h3>
                            <p class="text" set:html={item.text} />
                            <div class="row">
                                {item.command && <CommandChip class="chip" command={item.command} />}
                                {item.href && (
                                    <a class="prose-link go-link" href={item.href}>
                                        {item.link}
                                        <ArrowRightIcon size={15} weight="bold" aria-hidden="true" />
                                    </a>
                                )}
                            </div>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    /* No margin reset here: on a phone the shared rule spaces the list from the lead */
    .items {
        padding: 0;
        list-style: none;
    }


    .item:hover .wave-mark {
        transform: translateX(3px);
        filter: brightness(1.3);
    }

    .wave-mark {
        transition:
            transform var(--speed-normal) ease,
            filter var(--speed-normal) ease;
    }

    .item {
        display: flex;
        gap: 22px;
        padding: 30px 0 34px;
        border-top: 1px solid rgb(160 190 255 / 0.14);
    }

    .item:last-child {
        border-bottom: 1px solid rgb(160 190 255 / 0.14);
    }

    .item .wave-mark {
        margin-top: 8px;
    }

    .content {
        flex: 1;
        min-width: 0;
    }

    h3 {
        margin: 0;
        font-size: var(--type-title);
        font-weight: var(--weight-semibold);
        line-height: 1.3;
        color: var(--color-ink);
        text-wrap: balance;
    }

    .text {
        max-width: 58ch;
        margin: 10px 0 0;
        font-size: var(--type-lead);
        line-height: 1.6;
        color: var(--color-muted);
        text-wrap: pretty;
    }

    .row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 24px;
        margin-top: 18px;
    }


    @media (max-width: 899px) {
        .item {
            gap: 16px;
        }
    }

    /* Time stopped: the marks keep still when pointed at */
    :global(.night[data-still]) .wave-mark {
        transition: none;
    }

    :global(.night[data-still]) .item:hover .wave-mark {
        transform: none;
        filter: none;
    }
</style>
