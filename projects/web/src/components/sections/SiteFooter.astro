---
import FooterSeaFloor from "./FooterSeaFloor.astro"
import { links } from "../../lib/links"

interface Props {
    // Plain footers (such as docs) skip the sea floor, beams, bubbles, ending conductor and their script
    plain?: boolean
}

const { plain = false } = Astro.props
---

<footer class="site-footer">
    {!plain && <FooterSeaFloor />}
    <div class="row">
        <div class="brand">
            <a class="name" href="/">Fluxerly<span class="js">.js</span></a>
            <p class="tagline">A Fluxer-native bot SDK for JavaScript, TypeScript and Effect</p>
        </div>
        <nav class="links" aria-label="Footer">
            <a href={links.docs}>Docs</a>
            <a href={links.playground}>Playground</a>
            <a href={links.changelog}>Changelog</a>
            <a href={links.github} target="_blank" rel="noopener">GitHub</a>
            <a href={links.npm} target="_blank" rel="noopener">npm</a>
            <a href={links.neonfluxHome} target="_blank" rel="noopener">NeonFlux</a>
            <a href={links.license} target="_blank" rel="noopener">Apache-2.0</a>
        </nav>
    </div>
    <div class="fine">
        <p class="credit">Open source by <a href="https://github.com/NeonTechSpace" target="_blank" rel="noopener">NeonTechSpace</a></p>
        <p class="independent">Fluxerly.js is an independent project. It is not affiliated with, endorsed by or sponsored by Fluxer</p>
    </div>
</footer>

<style>
    :global(.docs) .site-footer {
        background: var(--color-night);
    }

    /* The footer's row and its rule line up with the content's edges, not the window's */
    .site-footer {
        /* Starts in the dark space ends in, across the whole width, so no edge shows where the page gives way to it */
        background: linear-gradient(to bottom, #03040f, var(--color-night) clamp(150px, 17vw, 260px));
    }

    .row,
    .fine {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        margin-inline: var(--frame-inline);
    }

    .row {
        gap: 8px 40px;
        padding-block: 20px 8px;
        /* A rule that fades out at both ends rather than stopping square */
        border-top: 1px solid transparent;
        border-image: linear-gradient(90deg, transparent, rgb(160 190 255 / 0.16) 18%, rgb(160 190 255 / 0.16) 82%, transparent) 1;
    }

    .fine {
        gap: 4px 40px;
        padding-bottom: 20px;
        font-size: var(--type-small);
        line-height: 1.5;
    }

    .brand {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 2px 16px;
    }

    /* Whose project this is not, for anyone who takes the name for Fluxer's own */
    .independent {
        margin: 0;
        color: rgb(195 200 230 / 0.72);
    }

    .name {
        font-size: var(--type-lead);
        font-weight: var(--weight-display);
        letter-spacing: var(--tracking-snug);
        color: var(--color-ink);
        text-decoration: none;
        border-radius: var(--corner-small);
        corner-shape: squircle;
        transition: color var(--speed-fast) ease;
    }

    .name:hover,
    .name:focus-visible {
        color: #ffffff;
    }

    .js {
        color: var(--color-cyan);
        transition: color var(--speed-fast) ease;
    }

    .name:hover .js,
    .name:focus-visible .js {
        color: var(--color-cyan-light);
    }

    .tagline {
        margin: 0;
        font-size: var(--type-body);
        color: rgb(195 200 230 / 0.78);
    }

    /* The org behind the SDK, quieter than the tagline. Its gold is the badge on the conductor's cap, the maker's mark */
    .credit {
        margin: 0;
        color: rgb(195 200 230 / 0.62);
    }

    .credit a {
        color: rgb(236 196 110 / 0.85);
        text-decoration: underline;
        text-decoration-color: rgb(236 196 110 / 0.3);
        text-underline-offset: 4px;
        border-radius: var(--corner-small);
        corner-shape: squircle;
        transition: text-decoration-color var(--speed-fast) ease;
    }

    .credit a:hover {
        text-decoration-color: rgb(236 196 110 / 0.8);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 28px;
    }

    .links a {
        font-size: var(--type-small);
        font-weight: var(--weight-regular);
        color: var(--color-muted);
        text-decoration: underline;
        text-decoration-color: transparent;
        text-underline-offset: 5px;
        border-radius: var(--corner-small);
        corner-shape: squircle;
        transition:
            color var(--speed-fast) ease,
            text-decoration-color var(--speed-fast) ease;
    }

    .links a:hover {
        color: var(--color-ink);
        text-decoration-color: rgb(238 240 255 / 0.5);
    }

    @media (max-width: 899px) {
        .links {
            row-gap: 0;
        }
    }
</style>
