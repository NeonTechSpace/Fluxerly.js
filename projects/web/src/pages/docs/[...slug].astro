---
import { render, type CollectionEntry } from 'astro:content'
import { Docs } from '../../components/Docs'
import Layout from '../../components/Layout.astro'
import { source } from '../../lib/source'
import versions from '../../../content/versions.json'
import { parseVersion } from '../../../scripts/versions.js'

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.join('/') },
    props: { entry: page.data.entry },
  }))
}
interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props
const { Content, headings } = await render(entry)
const routeSlugs = Astro.params.slug!.split('/')
const routeVersion = routeSlugs[0]!
const sourceVersion = routeVersion === 'latest' ? versions.defaultVersion : routeVersion
const channel = sourceVersion === 'preview' ? 'preview' : parseVersion(sourceVersion).channel
const availableTargets = routeVersion === 'preview' || versions.previewVersion
  ? [...versions.targets, { version: 'preview', label: 'Source preview' }]
  : versions.targets
const channelTabs = availableTargets.map((target) => ({
  label: target.label,
  url: source.getPage([
    routeVersion === 'latest' && target.version === sourceVersion ? 'latest' : target.version,
    ...routeSlugs.slice(1),
  ])?.url ?? `/docs/${routeVersion === 'latest' && target.version === sourceVersion ? 'latest' : target.version}/`,
  active: channel === (target.version === 'preview' ? 'preview' : parseVersion(target.version).channel),
}))
const toc = headings.map((h) => ({ depth: h.depth, title: h.text === 'Remarks' ? 'Usage details' : h.text, url: `#${h.slug}` }))
---
<Layout title={entry.data.title}>
  <Docs tree={source.getPageTree()} pathname={Astro.url.pathname} params={Astro.params}
    page={{ toc, footer: { enabled: routeSlugs[1] !== 'api' } }} version={routeVersion} channelTabs={channelTabs} client:load>
    <div class="version-label">{sourceVersion === 'preview' ? `${versions.previewVersion ? `Planned ${versions.previewVersion} · ` : ''}Unreleased source preview` : `SDK ${sourceVersion}`}</div>
    <h1>{entry.data.title}</h1>
    <aside class="preview-notice" aria-label="Important preview notice">
      <strong>IMPORTANT</strong>
      <span>{sourceVersion === 'preview' ? 'This version is still in development and cannot be installed yet' : 'This is a preview of the documentation website, not the final version'}</span>
    </aside>
    {entry.data.description && <p class="description">{entry.data.description}</p>}
    <div class="prose docs-content flex-1" data-api-reference={routeSlugs[1] === 'api' || undefined}><Content /></div>
  </Docs>
</Layout>

<style>
  .preview-notice {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-block: 1.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid #74623d;
    border-radius: 0.5rem;
    background: #292318;
    color: #eee2c7;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .preview-notice strong { color: #f4cf84; font-size: 0.75rem; letter-spacing: 0.04em; }
</style>
