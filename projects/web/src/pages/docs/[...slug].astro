---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { Docs } from '../../components/Docs'
import Layout from '../../components/Layout.astro'
import { source } from '../../lib/source'
import { breadcrumbsFor, treeForVersion } from '../../lib/docs-tree'
import { searchIndexUrl } from '../../lib/search-index'
import { markdownTwinUrl } from '../../lib/assistant-docs'
import versions from '../../../content/versions.json'
import { parseVersion } from '../../../scripts/versions.js'

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.join('/') },
    props: { entry: page.data.entry },
  }))
}
interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props
const { Content, headings } = await render(entry)
const routeSlugs = Astro.params.slug!.split('/')
const routeVersion = routeSlugs[0]!
const targets: { version: string; label: string; path: string }[] = versions.targets
const sourceVersion = targets.find((target) => target.path === routeVersion)?.version ?? routeVersion
const channel = sourceVersion === 'preview' ? 'preview' : parseVersion(sourceVersion).channel
const availableTargets = routeVersion === 'preview' || versions.previewVersion
  ? [...targets, { version: 'preview', label: 'Source preview', path: 'preview' }]
  : targets
const channelTabs = availableTargets.map((target) => ({
  label: target.label,
  url: source.getPage([target.path, ...routeSlugs.slice(1)])?.url ?? `/docs/${target.path}/`,
  active: channel === (target.version === 'preview' ? 'preview' : parseVersion(target.version).channel),
}))
const isReference = routeSlugs[1] === 'api'
// Reference pages list symbols and members, not every parameter and return heading.
// Category sections move grouped symbols one level deeper
const symbolDepth = headings.some((heading) => heading.slug.startsWith('category-')) ? 4 : 3
const toc = headings
  .filter((heading) => !isReference || heading.depth <= symbolDepth)
  .map((heading) => ({ depth: heading.depth, title: heading.text, url: `#${heading.slug}` }))
const pageTree = source.getPageTree()
const pageUrl = source.getPage(routeSlugs)!.url
const referenceMeta = (await getCollection('meta')).find((meta) =>
  meta.filePath?.replaceAll('\\', '/').endsWith(`content/docs/${routeVersion}/api/meta.json`))
const markdownUrl = isReference ? undefined : markdownTwinUrl(routeSlugs)
---
<Layout title={entry.data.title}>
  <Docs tree={treeForVersion(pageTree, routeVersion)} pathname={Astro.url.pathname} params={Astro.params}
    page={{ toc, footer: { enabled: !isReference } }} version={routeVersion} channelTabs={channelTabs}
    breadcrumbs={breadcrumbsFor(pageTree, routeVersion, pageUrl)} searchUrl={await searchIndexUrl(routeVersion)}
    referenceCategories={referenceMeta?.data.categories ?? {}} client:load>
    <div id="docs-page-start" tabindex="-1" class="docs-main">
      <div class="version-label">{sourceVersion === 'preview' ? `${versions.previewVersion ? `Planned ${versions.previewVersion} · ` : ''}Unreleased source preview` : `SDK ${sourceVersion}`}</div>
      <h1>{entry.data.title}</h1>
      <aside class="preview-notice" aria-label="Important preview notice">
        <strong>IMPORTANT</strong>
        <span>{sourceVersion === 'preview' ? 'This version is still in development and cannot be installed yet' : 'This is a preview of the documentation website, not the final version'}</span>
      </aside>
      {markdownUrl && (
        <div class="page-actions">
          <button type="button" data-copy-markdown={markdownUrl} hidden>Copy page as Markdown</button>
          <a href={markdownUrl}>View as Markdown</a>
          <span data-copy-markdown-status role="status"></span>
        </div>
      )}
      {entry.data.description && <p class="description">{entry.data.description}</p>}
      <div class="prose docs-content flex-1" data-api-reference={isReference || undefined}><Content /></div>
    </div>
  </Docs>
</Layout>

<style>
  .preview-notice {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-block: 1.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid #74623d;
    border-radius: 0.5rem;
    background: #292318;
    color: #eee2c7;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .preview-notice strong { color: #f4cf84; font-size: 0.75rem; letter-spacing: 0.04em; }
  .docs-main:focus { outline: none; }
</style>
