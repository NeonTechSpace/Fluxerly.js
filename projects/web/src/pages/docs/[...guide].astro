---
import { titleCase } from "../../lib/title-case"
import { getCollection, render, type CollectionEntry } from "astro:content"
import Docs from "../../layouts/Docs.astro"
import type { TocItem } from "../../lib/docs-nav"

export async function getStaticPaths() {
    const guides = await getCollection("guides", (entry) => entry.id !== "index")
    return guides.map((entry) => ({ params: { guide: entry.id }, props: { entry } }))
}

const { entry } = Astro.props as { entry: CollectionEntry<"guides"> }
const { Content, headings } = await render(entry)
const toc = headings.filter((heading): heading is typeof heading & { depth: TocItem["depth"] } => heading.depth === 2 || heading.depth === 3)
---

<Docs
    title={entry.data.title}
    description={entry.data.description}
    section="guides"
    current={`/docs/${entry.id}/`}
    toc={toc.map((heading) => ({ depth: heading.depth, text: titleCase(heading.text), id: heading.slug }))}
>
    <Content />
</Docs>
