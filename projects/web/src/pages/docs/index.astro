---
import { titleCase } from "../../lib/title-case"
import { getEntry, render } from "astro:content"
import Docs from "../../layouts/Docs.astro"
import type { TocItem } from "../../lib/docs-nav"
import { endpoints } from "../../lib/endpoints"
import { fluxerPinOf } from "../../lib/fluxer-pin"

const entry = await getEntry("guides", "index")
if (!entry) throw new Error("The docs overview content/guides/index.md is missing")
const { Content, headings } = await render(entry)
// The Fluxer commit this version was checked against, which the sidebar names on every page
const fluxerPin = fluxerPinOf(endpoints.source)
const toc = headings.filter((heading): heading is typeof heading & { depth: TocItem["depth"] } => heading.depth === 2 || heading.depth === 3)
---

<Docs
    title={entry.data.title}
    description={entry.data.description}
    searchTerms={entry.data.search}
    section="guides"
    current="/docs/"
    toc={toc.map((heading) => ({ depth: heading.depth, text: titleCase(heading.text), id: heading.slug }))}
>
    <Content />
    {
        fluxerPin && (
            <p class="fluxer-pin-note" data-pagefind-ignore>
                This version of Fluxerly.js was checked against Fluxer at commit{" "}
                <a href={fluxerPin.url} target="_blank" rel="noopener" data-fluxer-pin={fluxerPin.commit}>
                    {fluxerPin.short}
                </a>
            </p>
        )
    }
</Docs>
