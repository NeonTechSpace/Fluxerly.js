---
import "../styles/global.css"
import Header from "../components/Header.astro"
import PageTransitions from "../components/PageTransitions.astro"
import Seo from "../components/Seo.astro"
import SiteFooter from "../components/sections/SiteFooter.astro"
import { mascotArt, mascotSizes, mascotSrcset } from "../lib/art"
import { homeDescription, homeTitle } from "../lib/seo"
// The one Outfit file the pages' Latin text needs, asked for with the page instead of after its stylesheet
import outfitUrl from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url"

interface Props {
    title?: string
    description?: string
    noindex?: boolean
    graph?: Record<string, unknown>[]
}

const { title = homeTitle, description = homeDescription, noindex, graph } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <!-- The homepage's heaviest picture, wanted at the size the hero draws it, asked for before any stylesheet can hold the parser up -->
        {Astro.url.pathname === "/" && <link rel="preload" as="image" fetchpriority="high" href={mascotArt.small} imagesrcset={mascotSrcset} imagesizes={mascotSizes} />}
        <Seo title={title} description={description} noindex={noindex} graph={graph} />
        <link rel="preload" href={outfitUrl} as="font" type="font/woff2" crossorigin />
        <PageTransitions />
        <!-- The homepage's first frame waits for the whole hero, so a reload never shows the header alone, with the conductor gone,
             before the hero arrives. Browsers without this link, such as Firefox, keep the page unseen until the hero's end instead,
             see Hero.astro, and a page that never gets there shows after a few seconds. Where the link works the page is never
             drawn while it is unseen, so nothing changes there -->
        {
            Astro.url.pathname === "/" && (
                <>
                    <link rel="expect" href="#hero-end" blocking="render" />
                    <style is:inline>
                        html[data-hero-hold] body {
                            opacity: 0;
                        }
                    </style>
                    <script is:inline>
                        document.documentElement.dataset.heroHold = ""
                        setTimeout(() => delete document.documentElement.dataset.heroHold, 3000)
                    </script>
                </>
            )
        }
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to Content</a>
        <Header />
        <main id="main">
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
