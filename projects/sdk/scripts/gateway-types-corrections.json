                "fluxer_gateway/src/session/session_guild_health.erl:51-54"
            ],
            "scope": "Guild connection",
            "fields": [
                {
                    "name": "guild_id",
                    "optional": false,
                    "description": "The ID of the guild",
                    "shape": {
                        "kind": "snowflake"
                    }
                },
                {
                    "name": "degraded",
                    "optional": false,
                    "description": "Whether the guild is degraded",
                    "shape": {
                        "kind": "boolean"
                    }
                }
            ]
        }
    ]
}
