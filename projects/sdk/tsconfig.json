{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "lib": ["ES2024", "ESNext.Disposable", "DOM"],
        "types": [],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitOnError": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src/**/*.ts"]
}
