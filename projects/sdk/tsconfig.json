{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "lib": ["ES2024", "ESNext.Disposable", "DOM"],
        "types": [],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitOnError": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "plugins": [
            {
                "name": "@effect/language-service",
                "diagnosticSeverity": {
                    "lazyEffect": "off"
                },
                "overrides": [
                    {
                        "include": ["tests/**/*.ts"],
                        "options": {
                            "diagnosticSeverity": {
                                "unknownInEffectCatch": "off",
                                "globalErrorInEffectFailure": "off"
                            }
                        }
                    },
                    {
                        "include": [
                            "tests/packaging/consumers/**/*.ts",
                            "tests/resources/commands/command-message-types.ts"
                        ],
                        "options": {
                            "diagnosticSeverity": {
                                "floatingEffect": "off",
                                "missingEffectContext": "off"
                            }
                        }
                    }
                ]
            }
        ]
    },
    "include": ["src/**/*.ts"]
}
